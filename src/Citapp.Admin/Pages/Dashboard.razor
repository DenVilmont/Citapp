@page "/dashboard"
@inject AdminSession Session
@inject ITenantRepository TenantRepository
@inject IBookingRepository BookingRepository
@inject NavigationManager Nav

<h3>Dashboard</h3>

@if (_loading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <p style="color:red">@_error</p>
}
else
{
    <div class="row">
        <div><strong>This week occupied slots:</strong> @_occupiedThisWeek</div>
        <div><strong>Active customer bookings:</strong> @_activeCustomerBookingsThisWeek</div>
        <div><strong>Blocked/held slots:</strong> @_blockedOrHeldSlotsThisWeek</div>
        <div><strong>WhatsApp status:</strong> @_waStatus</div>
    </div>

        <h4>Today</h4>
        <ul>
        @foreach (var booking in _today)
        {
            <li>@FormatTimeRange(booking.StartAt, booking.EndAt) (@booking.Status)</li>
        }
        </ul>

    <h4>Upcoming</h4>
        <ul>
        @foreach (var booking in _upcoming)
        {
            <li>@FormatDateTime(booking.StartAt):yyyy-MM-dd HH:mm (@booking.Status)</li>
        }
        </ul>
}

@code {
    private bool _loading = true;
    private string _error = string.Empty;
    private string _waStatus = "not connected";
    private int _occupiedThisWeek;
    private int _activeCustomerBookingsThisWeek;
    private int _blockedOrHeldSlotsThisWeek;
    private List<BookingDto> _today = new();
    private List<BookingDto> _upcoming = new();
    private TimeZoneInfo _tenantTimeZone = TimeZoneInfo.Utc;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated || Session.TenantId is null)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        try
        {
            var tenantId = Session.TenantId.Value;
            var tenant = await TenantRepository.GetAsync(tenantId);
            _tenantTimeZone = ResolveTimeZone(tenant?.Timezone);

            var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, _tenantTimeZone).DateTime);
            var endOfWeek = today.AddDays(6 - (int)today.DayOfWeek);

            // Occupied time semantics:
            // - Booked + BlockedByMaster occupy slots.
            // - Completed/NoShow/Cancelled do not occupy future availability.
            var activeCustomerBookings = await BookingRepository.GetForRangeAsync(tenantId, today, endOfWeek, BookingStatus.Booked);
            var blockedOrHeldSlots = await BookingRepository.GetForRangeAsync(tenantId, today, endOfWeek, BookingStatus.BlockedByMaster);

            _activeCustomerBookingsThisWeek = activeCustomerBookings.Count;
            _blockedOrHeldSlotsThisWeek = blockedOrHeldSlots.Count;
            _occupiedThisWeek = _activeCustomerBookingsThisWeek + _blockedOrHeldSlotsThisWeek;

            _today = (await BookingRepository.GetForRangeAsync(tenantId, today, today, null)).OrderBy(x => x.StartAt).ToList();
            _upcoming = (await BookingRepository.GetUpcomingAsync(tenantId, DateTimeOffset.UtcNow)).Take(10).ToList();

            var wa = await TenantRepository.GetWhatsAppConnectionAsync(tenantId);
            _waStatus = wa is null ? "not connected" : $"{wa.Status} ({wa.PhoneNumber})";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private DateTime FormatDateTime(DateTimeOffset value)
        => TimeZoneInfo.ConvertTime(value, _tenantTimeZone).DateTime;

    private string FormatTimeRange(DateTimeOffset start, DateTimeOffset end)
        => $"{FormatDateTime(start):HH:mm} - {FormatDateTime(end):HH:mm}";

    private static TimeZoneInfo ResolveTimeZone(string? timezone)
    {
        if (string.IsNullOrWhiteSpace(timezone))
        {
            return TimeZoneInfo.Utc;
        }

        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(timezone);
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.Utc;
        }
        catch (InvalidTimeZoneException)
        {
            return TimeZoneInfo.Utc;
        }
    }
}
