@page "/customerlist"
@page "/customers"
@inject AdminSession Session
@inject CustomerPageService CustomerPageService
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Class="mb-4">Customers</MudText>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudGrid>
        <MudItem xs="12" md="9">
            <MudTextField @bind-Value="_query" Label="Search by name, WA user id, phone" Variant="Variant.Outlined" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Search</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@_message</MudAlert>
}

<MudTable Items="_customers" Dense="true" Hover="true" Outlined="true">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>WA user</MudTh>
        <MudTh>Phone</MudTh>
        <MudTh>Bookings</MudTh>
        <MudTh>Last seen</MudTh>
        <MudTh>Note</MudTh>
        <MudTh>Card</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.DisplayName</MudTd>
        <MudTd DataLabel="WA user">@context.WaUserId</MudTd>
        <MudTd DataLabel="Phone">@context.Phone</MudTd>
        <MudTd DataLabel="Bookings">@context.BookingCount</MudTd>
        <MudTd DataLabel="Last seen">@context.LastSeenAt</MudTd>
        <MudTd DataLabel="Note" Style="min-width: 260px;">
            <MudTextField @bind-Value="_notes[context.Id]" Variant="Variant.Outlined" Lines="2" FullWidth="true" Margin="Margin.Dense" />
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SaveNoteAsync(context.Id)">Save note</MudButton>
        </MudTd>
        <MudTd DataLabel="Card">
            <MudLink Href="@($"/customercard/{context.Id}")">Open</MudLink>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private string _query = string.Empty;
    private List<CustomerDto> _customers = new();
    private readonly Dictionary<Guid, string> _notes = new();
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated || Session.TenantId is null)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _customers = await CustomerPageService.SearchAsync(Session.TenantId!.Value, _query);
        _notes.Clear();
        foreach (var c in _customers)
        {
            _notes[c.Id] = c.MasterNote ?? string.Empty;
        }
    }

    private async Task SaveNoteAsync(Guid customerId)
    {
        await CustomerPageService.SaveNoteAsync(Session.TenantId!.Value, customerId, _notes[customerId]);
        _message = "Note updated.";
    }
}
