@page "/servicelist"
@page "/services"
@using Microsoft.AspNetCore.Components.Forms
@inject AdminSession Session
@inject ServicePageService ServicePageService
@inject NavigationManager Nav

<h3>Services</h3>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <p>@_message</p>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <p style="color:red">@_error</p>
}

<div style="border:1px solid #ddd; padding:12px; margin-bottom:12px;">
    <h4>@(_editingId is null ? "Create service" : "Edit service")</h4>
    <div><label>Name</label><br /><input @bind="_name" /></div>
    <div><label>Description</label><br /><textarea @bind="_description"></textarea></div>
    <div class="row">
        <div><label>Duration min</label><br /><input @bind="_duration" type="number" /></div>
        <div><label>Price</label><br /><input @bind="_price" type="number" step="0.01" /></div>
        <div><label>Currency</label><br /><input @bind="_currency" /></div>
    </div>
    <div><label><input @bind="_isActive" type="checkbox" /> Active</label></div>
    <button @onclick="SaveAsync">Save</button>
    @if (_editingId is not null)
    {
        <button @onclick="ResetForm">Cancel edit</button>
    }
</div>

<p style="margin:4px 0 12px 0; color:#555;">Drag and drop rows to reorder services.</p>
<table>
    <thead><tr><th></th><th>Name</th><th>Duration</th><th>Price</th><th>Active</th><th>Media</th><th></th></tr></thead>
    <tbody>
    @foreach (var service in _services)
    {
        <tr draggable="true"
            @ondragstart="() => StartDrag(service.Id)"
            @ondragover:preventDefault
            @ondrop="() => DropOnServiceAsync(service.Id)"
            style="border-top:1px solid #eee; vertical-align:top;">
            <td style="cursor:grab;">↕</td>
            <td>@service.Name</td>
            <td>@service.DurationMinutes min</td>
            <td>@service.PriceAmount @service.Currency</td>
            <td>@(service.IsActive ? "Yes" : "No")</td>
            <td>
                <InputFile OnChange="(e) => UploadMediaAsync(service.Id, e)" accept="image/*" />
                <div style="margin-top:6px;">
                    @foreach (var media in GetMedia(service.Id))
                    {
                        <div style="margin-bottom:4px;">
                            <a href="@media.PublicUrl" target="_blank">image</a>
                            @if (media.IsPrimary)
                            {
                                <b>(primary)</b>
                            }
                            else
                            {
                                <button @onclick="() => SetPrimaryAsync(service.Id, media.Id)">Set primary</button>
                            }
                            <button @onclick="() => DeleteMediaAsync(service.Id, media.Id)">Delete</button>
                        </div>
                    }
                </div>
            </td>
            <td>
                <button @onclick="() => Edit(service)">Edit</button>
                <button @onclick="() => ToggleActiveAsync(service)">@((service.IsActive ? "Deactivate" : "Activate"))</button>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    private readonly List<ServiceDto> _services = new();
    private readonly Dictionary<Guid, List<ServiceMediaDto>> _mediaByServiceId = new();
    private Guid? _editingId;
    private Guid? _draggedServiceId;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private int _duration = 30;
    private decimal _price;
    private string _currency = "EUR";
    private bool _isActive = true;
    private string _error = string.Empty;
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated || Session.TenantId is null)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var pageData = await ServicePageService.LoadAsync(Session.TenantId!.Value);
        _services.Clear();
        _services.AddRange(pageData.Services);

        _mediaByServiceId.Clear();
        foreach (var (serviceId, media) in pageData.MediaByServiceId)
        {
            _mediaByServiceId[serviceId] = media;
        }
    }

    private async Task SaveAsync()
    {
        _error = string.Empty;
        _message = string.Empty;

        try
        {
            var currentSortOrder = _editingId is null
                ? (int?)null
                : _services.FirstOrDefault(x => x.Id == _editingId.Value)?.SortOrder;

            var error = await ServicePageService.SaveAsync(
                Session.TenantId!.Value,
                new ServiceEditState(_editingId, _name, _description, _duration, _price, _currency, _isActive),
                _services.Count,
                currentSortOrder);

            if (error is not null)
            {
                _error = error;
                return;
            }

            _message = _editingId is null ? "Service created." : "Service updated.";
            ResetForm();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Edit(ServiceDto service)
    {
        _editingId = service.Id;
        _name = service.Name;
        _description = service.Description ?? string.Empty;
        _duration = service.DurationMinutes;
        _price = service.PriceAmount;
        _currency = service.Currency;
        _isActive = service.IsActive;
    }

    private async Task ToggleActiveAsync(ServiceDto service)
    {
        await ServicePageService.ToggleActiveAsync(Session.TenantId!.Value, service.Id, !service.IsActive);
        await ReloadAsync();
    }

    private void StartDrag(Guid serviceId) => _draggedServiceId = serviceId;

    private async Task DropOnServiceAsync(Guid targetServiceId)
    {
        if (_draggedServiceId is null || _draggedServiceId == targetServiceId)
        {
            return;
        }

        var draggedIndex = _services.FindIndex(x => x.Id == _draggedServiceId.Value);
        var targetIndex = _services.FindIndex(x => x.Id == targetServiceId);
        if (draggedIndex < 0 || targetIndex < 0)
        {
            return;
        }

        var moved = _services[draggedIndex];
        _services.RemoveAt(draggedIndex);
        if (targetIndex > draggedIndex)
        {
            targetIndex--;
        }

        _services.Insert(targetIndex, moved);
        _draggedServiceId = null;

        await ServicePageService.UpdateSortOrdersAsync(Session.TenantId!.Value, _services.Select(x => x.Id).ToList());
        await ReloadAsync();
    }

    private async Task UploadMediaAsync(Guid serviceId, InputFileChangeEventArgs e)
    {
        _error = string.Empty;
        var error = await ServicePageService.UploadMediaAsync(Session.TenantId!.Value, serviceId, e.File, Session.AccessToken);
        if (error is not null)
        {
            _error = error;
            return;
        }

        _message = "Image uploaded.";
        _mediaByServiceId[serviceId] = await ServicePageService.GetMediaAsync(Session.TenantId.Value, serviceId);
    }

    private async Task SetPrimaryAsync(Guid serviceId, Guid mediaId)
    {
        await ServicePageService.SetPrimaryAsync(Session.TenantId!.Value, serviceId, mediaId);
        _mediaByServiceId[serviceId] = await ServicePageService.GetMediaAsync(Session.TenantId.Value, serviceId);
    }

    private async Task DeleteMediaAsync(Guid serviceId, Guid mediaId)
    {
        await ServicePageService.DeleteMediaAsync(Session.TenantId!.Value, serviceId, mediaId, Session.AccessToken);
        _mediaByServiceId[serviceId] = await ServicePageService.GetMediaAsync(Session.TenantId.Value, serviceId);
    }

    private List<ServiceMediaDto> GetMedia(Guid serviceId)
        => _mediaByServiceId.TryGetValue(serviceId, out var items) ? items : new List<ServiceMediaDto>();

    private void ResetForm()
    {
        _editingId = null;
        _name = string.Empty;
        _description = string.Empty;
        _duration = 30;
        _price = 0;
        _currency = "EUR";
        _isActive = true;
    }
}
