@page "/servicelist"
@page "/services"
@using Microsoft.AspNetCore.Components.Forms
@inject AdminSession Session
@inject ServicePageService ServicePageService
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Class="mb-4">Services</MudText>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@_message</MudAlert>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
}

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-3">@(_editingId is null ? "Create service" : "Edit service")</MudText>
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_description" Label="Description" Lines="3" Variant="Variant.Outlined" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudNumericField @bind-Value="_duration" Label="Duration min" Variant="Variant.Outlined" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudNumericField @bind-Value="_price" Label="Price" Variant="Variant.Outlined" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="_currency" Label="Currency" Variant="Variant.Outlined" FullWidth="true" />
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudCheckBox @bind-Value="_isActive" Label="Active" Color="Color.Primary" />
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Save</MudButton>
        @if (_editingId is not null)
        {
            <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="ResetForm">Cancel edit</MudButton>
        }
    </MudStack>
</MudPaper>

<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Drag and drop rows to reorder services.</MudText>

<MudTable Items="_services" Dense="true" Hover="true" Outlined="true">
    <HeaderContent>
        <MudTh></MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Duration</MudTh>
        <MudTh>Price</MudTh>
        <MudTh>Active</MudTh>
        <MudTh>Media</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Reorder">
            <div draggable="true"
                 @ondragstart="() => StartDrag(context.Id)"
                 @ondragover:preventDefault
                 @ondrop="() => DropOnServiceAsync(context.Id)"
                 style="cursor: grab; font-size: 18px;">↕</div>
        </MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Duration">@context.DurationMinutes min</MudTd>
        <MudTd DataLabel="Price">@context.PriceAmount @context.Currency</MudTd>
        <MudTd DataLabel="Active">
            <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Default)" Variant="Variant.Outlined" Size="Size.Small">
                @(context.IsActive ? "Yes" : "No")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Media">
            <InputFile OnChange="(e) => UploadMediaAsync(context.Id, e)" accept="image/*" />
            <MudStack Spacing="1" Class="mt-2">
                @foreach (var media in GetMedia(context.Id))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudLink Href="@media.PublicUrl" Target="_blank">image</MudLink>
                        @if (media.IsPrimary)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">primary</MudChip>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SetPrimaryAsync(context.Id, media.Id)">Set primary</MudButton>
                        }
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteMediaAsync(context.Id, media.Id)">Delete</MudButton>
                    </MudStack>
                }
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudStack Row="true" Spacing="1">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => Edit(context)">Edit</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ToggleActiveAsync(context)">@((context.IsActive ? "Deactivate" : "Activate"))</MudButton>
            </MudStack>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private readonly List<ServiceDto> _services = new();
    private readonly Dictionary<Guid, List<ServiceMediaDto>> _mediaByServiceId = new();
    private Guid? _editingId;
    private Guid? _draggedServiceId;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private int _duration = 30;
    private decimal _price;
    private string _currency = "EUR";
    private bool _isActive = true;
    private string _error = string.Empty;
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated || Session.TenantId is null)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var pageData = await ServicePageService.LoadAsync(Session.TenantId!.Value);
        _services.Clear();
        _services.AddRange(pageData.Services);

        _mediaByServiceId.Clear();
        foreach (var (serviceId, media) in pageData.MediaByServiceId)
        {
            _mediaByServiceId[serviceId] = media;
        }
    }

    private async Task SaveAsync()
    {
        _error = string.Empty;
        _message = string.Empty;

        try
        {
            var currentSortOrder = _editingId is null
                ? (int?)null
                : _services.FirstOrDefault(x => x.Id == _editingId.Value)?.SortOrder;

            var error = await ServicePageService.SaveAsync(
                Session.TenantId!.Value,
                new ServiceEditState(_editingId, _name, _description, _duration, _price, _currency, _isActive),
                _services.Count,
                currentSortOrder);

            if (error is not null)
            {
                _error = error;
                return;
            }

            _message = _editingId is null ? "Service created." : "Service updated.";
            ResetForm();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Edit(ServiceDto service)
    {
        _editingId = service.Id;
        _name = service.Name;
        _description = service.Description ?? string.Empty;
        _duration = service.DurationMinutes;
        _price = service.PriceAmount;
        _currency = service.Currency;
        _isActive = service.IsActive;
    }

    private async Task ToggleActiveAsync(ServiceDto service)
    {
        await ServicePageService.ToggleActiveAsync(Session.TenantId!.Value, service.Id, !service.IsActive);
        await ReloadAsync();
    }

    private void StartDrag(Guid serviceId) => _draggedServiceId = serviceId;

    private async Task DropOnServiceAsync(Guid targetServiceId)
    {
        if (_draggedServiceId is null || _draggedServiceId == targetServiceId)
        {
            return;
        }

        var draggedIndex = _services.FindIndex(x => x.Id == _draggedServiceId.Value);
        var targetIndex = _services.FindIndex(x => x.Id == targetServiceId);
        if (draggedIndex < 0 || targetIndex < 0)
        {
            return;
        }

        var moved = _services[draggedIndex];
        _services.RemoveAt(draggedIndex);
        if (targetIndex > draggedIndex)
        {
            targetIndex--;
        }

        _services.Insert(targetIndex, moved);
        _draggedServiceId = null;

        await ServicePageService.UpdateSortOrdersAsync(Session.TenantId!.Value, _services.Select(x => x.Id).ToList());
        await ReloadAsync();
    }

    private async Task UploadMediaAsync(Guid serviceId, InputFileChangeEventArgs e)
    {
        _error = string.Empty;
        var error = await ServicePageService.UploadMediaAsync(Session.TenantId!.Value, serviceId, e.File, Session.AccessToken);
        if (error is not null)
        {
            _error = error;
            return;
        }

        _message = "Image uploaded.";
        _mediaByServiceId[serviceId] = await ServicePageService.GetMediaAsync(Session.TenantId.Value, serviceId);
    }

    private async Task SetPrimaryAsync(Guid serviceId, Guid mediaId)
    {
        await ServicePageService.SetPrimaryAsync(Session.TenantId!.Value, serviceId, mediaId);
        _mediaByServiceId[serviceId] = await ServicePageService.GetMediaAsync(Session.TenantId.Value, serviceId);
    }

    private async Task DeleteMediaAsync(Guid serviceId, Guid mediaId)
    {
        await ServicePageService.DeleteMediaAsync(Session.TenantId!.Value, serviceId, mediaId, Session.AccessToken);
        _mediaByServiceId[serviceId] = await ServicePageService.GetMediaAsync(Session.TenantId.Value, serviceId);
    }

    private List<ServiceMediaDto> GetMedia(Guid serviceId)
        => _mediaByServiceId.TryGetValue(serviceId, out var items) ? items : new List<ServiceMediaDto>();

    private void ResetForm()
    {
        _editingId = null;
        _name = string.Empty;
        _description = string.Empty;
        _duration = 30;
        _price = 0;
        _currency = "EUR";
        _isActive = true;
    }
}
