@page "/bookingcalendar"
@page "/bookings"
@inject AdminSession Session
@inject BookingPageService BookingPageService
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Class="mb-1">Bookings</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Times shown in @_tenantTimeZone.Id</MudText>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
}
@if (!string.IsNullOrWhiteSpace(_message))
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@_message</MudAlert>
}

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudGrid>
        <MudItem xs="12" md="3"><MudTextField @bind-Value="_fromText" Label="From" InputType="InputType.Date" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="3"><MudTextField @bind-Value="_toText" Label="To" InputType="InputType.Date" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string" Label="Status" @bind-Value="_statusText" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="">All</MudSelectItem>
                <MudSelectItem Value="Booked">Booked</MudSelectItem>
                <MudSelectItem Value="Completed">Completed</MudSelectItem>
                <MudSelectItem Value="Cancelled">Cancelled</MudSelectItem>
                <MudSelectItem Value="NoShow">NoShow</MudSelectItem>
                <MudSelectItem Value="BlockedByMaster">BlockedByMaster</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadBookingsAsync">Apply</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_bookings" Dense="true" Hover="true" Outlined="true" Class="mb-4">
    <HeaderContent>
        <MudTh>Date</MudTh>
        <MudTh>Time</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Source</MudTh>
        <MudTh>Customer</MudTh>
        <MudTh>Service</MudTh>
        <MudTh>Price</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Date">@FormatDateTime(context.StartAt).ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="Time">@FormatTimeRange(context.StartAt, context.EndAt)</MudTd>
        <MudTd DataLabel="Status">@context.Status</MudTd>
        <MudTd DataLabel="Source">@context.Source</MudTd>
        <MudTd DataLabel="Customer">
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudText>@ResolveCustomerLabel(context.CustomerId)</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => OpenCustomerCard(context.CustomerId)">Open card</MudButton>
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Service">@ResolveServiceLabel(context.ServiceId)</MudTd>
        <MudTd DataLabel="Price">@context.PriceSnapshotAmount @context.CurrencySnapshot</MudTd>
        <MudTd DataLabel="Actions">
            <MudStack Row="true" Spacing="1">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => UpdateStatusAsync(context.Id, BookingStatus.Completed)">complete</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => UpdateStatusAsync(context.Id, BookingStatus.NoShow)">no_show</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => UpdateStatusAsync(context.Id, BookingStatus.BlockedByMaster)">block</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => UpdateStatusAsync(context.Id, BookingStatus.Cancelled)">cancel</MudButton>
            </MudStack>
        </MudTd>
    </RowTemplate>
</MudTable>

<MudPaper Class="pa-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-3">Manual booking</MudText>

    <MudGrid>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_customerSearch" Label="Find customer" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="2" Class="d-flex align-end"><MudButton Variant="Variant.Outlined" OnClick="SearchCustomersAsync">Search</MudButton></MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Select customer" @bind-Value="_selectedCustomerId" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="">Select customer</MudSelectItem>
                @foreach (var c in _customerOptions)
                {
                    <MudSelectItem Value="@c.Id.ToString()">@c.DisplayName (@c.WaUserId)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
        <MudItem xs="12"><MudText Typo="Typo.subtitle2">Create customer inline</MudText></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_newCustomerDisplayName" Label="Display name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_newCustomerPhone" Label="Phone (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-end"><MudButton Variant="Variant.Outlined" OnClick="CreateManualCustomerAsync">Create and select</MudButton></MudItem>

        <MudItem xs="12" md="5">
            <MudSelect T="string" Label="Select service" @bind-Value="_selectedServiceId" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="">Select service</MudSelectItem>
                @foreach (var s in _activeServiceOptions)
                {
                    <MudSelectItem Value="@s.Id.ToString()">@s.Name (@s.DurationMinutes min)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3"><MudTextField @bind-Value="_slotDateText" Label="Date" InputType="InputType.Date" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-end"><MudButton Variant="Variant.Outlined" OnClick="LoadSlotsAsync">Load slots (BotApi)</MudButton></MudItem>

        <MudItem xs="12" md="8">
            <MudSelect T="string" Label="Select slot" @bind-Value="_selectedSlotStart" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="">Select slot</MudSelectItem>
                @foreach (var slot in _slots)
                {
                    <MudSelectItem Value="@slot.StartAt">@slot.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateBookingAsync">Create booking</MudButton></MudItem>
    </MudGrid>
</MudPaper>

@code {
    private string _fromText = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
    private string _toText = DateTime.UtcNow.Date.AddDays(14).ToString("yyyy-MM-dd");
    private string _statusText = string.Empty;
    private List<BookingDto> _bookings = new();

    private string _customerSearch = string.Empty;
    private List<CustomerDto> _customerOptions = new();
    private List<ServiceDto> _activeServiceOptions = new();
    private readonly Dictionary<Guid, string> _customerLabels = new();
    private readonly Dictionary<Guid, string> _serviceLabels = new();
    private string _selectedCustomerId = string.Empty;
    private string _selectedServiceId = string.Empty;
    private string _slotDateText = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
    private List<TimeSlotVm> _slots = new();
    private string _selectedSlotStart = string.Empty;

    private string _newCustomerDisplayName = string.Empty;
    private string _newCustomerPhone = string.Empty;

    private string _error = string.Empty;
    private string _message = string.Empty;
    private TimeZoneInfo _tenantTimeZone = TimeZoneInfo.Utc;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated || Session.TenantId is null)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        var initData = await BookingPageService.LoadInitAsync(Session.TenantId.Value);
        _tenantTimeZone = initData.TenantTimeZone;
        _activeServiceOptions = initData.ActiveServices;
        await LoadBookingsAsync();
    }

    private async Task LoadBookingsAsync()
    {
        _error = string.Empty;
        var data = await BookingPageService.LoadBookingsAsync(Session.TenantId!.Value, _fromText, _toText, _statusText);

        _bookings = data.Bookings;
        _customerLabels.Clear();
        _serviceLabels.Clear();
        foreach (var (id, label) in data.CustomerLabels) _customerLabels[id] = label;
        foreach (var (id, label) in data.ServiceLabels) _serviceLabels[id] = label;
    }

    private async Task SearchCustomersAsync()
    {
        _customerOptions = await BookingPageService.SearchCustomersAsync(Session.TenantId!.Value, _customerSearch);
    }

    private async Task CreateManualCustomerAsync()
    {
        _error = string.Empty;
        _message = string.Empty;

        var (customer, error) = await BookingPageService.CreateManualCustomerAsync(
            Session.TenantId!.Value,
            _newCustomerDisplayName,
            _newCustomerPhone);

        if (error is not null)
        {
            _error = error;
            return;
        }

        _customerOptions.Insert(0, customer!);
        _selectedCustomerId = customer!.Id.ToString();
        _newCustomerDisplayName = string.Empty;
        _newCustomerPhone = string.Empty;
        _message = $"Customer created ({customer.DisplayName}).";
    }

    private async Task LoadSlotsAsync()
    {
        _error = string.Empty;
        _slots.Clear();
        _selectedSlotStart = string.Empty;

        var serviceId = Guid.TryParse(_selectedServiceId, out var parsed) ? parsed : Guid.Empty;
        var (slots, error) = await BookingPageService.LoadSlotsAsync(serviceId, _slotDateText);
        if (error is not null)
        {
            _error = error;
            return;
        }

        _slots = slots;
    }

    private async Task CreateBookingAsync()
    {
        _error = string.Empty;
        _message = string.Empty;

        var input = new BookingCreateInput(
            Guid.TryParse(_selectedCustomerId, out var customerId) ? customerId : Guid.Empty,
            Guid.TryParse(_selectedServiceId, out var serviceId) ? serviceId : Guid.Empty,
            DateTimeOffset.TryParse(_selectedSlotStart, out var startAt) ? startAt : default);

        try
        {
            var error = await BookingPageService.CreateBookingAsync(input, _activeServiceOptions, _slots);
            if (error is not null)
            {
                _error = error;
                return;
            }

            _message = "Booking created.";
            await LoadBookingsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string ResolveCustomerLabel(Guid customerId)
        => _customerLabels.TryGetValue(customerId, out var label) ? label : customerId.ToString();

    private string ResolveServiceLabel(Guid serviceId)
        => _serviceLabels.TryGetValue(serviceId, out var label) ? label : serviceId.ToString();

    private DateTime FormatDateTime(DateTimeOffset value)
        => TimeZoneInfo.ConvertTime(value, _tenantTimeZone).DateTime;

    private string FormatTimeRange(DateTimeOffset start, DateTimeOffset end)
        => $"{FormatDateTime(start):HH:mm} - {FormatDateTime(end):HH:mm}";

    private void OpenCustomerCard(Guid customerId)
        => Nav.NavigateTo($"/customercard/{customerId}");

    private async Task UpdateStatusAsync(Guid bookingId, BookingStatus status)
    {
        _error = string.Empty;
        _message = string.Empty;

        try
        {
            await BookingPageService.UpdateStatusAsync(bookingId, status);
            _message = $"Booking updated to {status}.";
            await LoadBookingsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
