@page "/profile"
@inject AdminSession Session
@inject IProfileRepository ProfileRepository
@inject ITenantRepository TenantRepository
@inject NavigationManager Nav

<h3>Profile</h3>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    if (!string.IsNullOrWhiteSpace(_message))
    {
        <p>@_message</p>
    }
    if (!string.IsNullOrWhiteSpace(_error))
    {
        <p style="color:red">@_error</p>
    }

    <h4>Account</h4>
    <div><label>Email</label><br /><input @bind="_email" disabled /></div>
    <div><label>Display name</label><br /><input @bind="_displayName" /></div>

    <h4>Business</h4>
    <div><label>Business name</label><br /><input @bind="_businessName" /></div>
    <div><label>About</label><br /><textarea @bind="_aboutText"></textarea></div>
    <div><label>Greeting text</label><br /><textarea @bind="_greetingText"></textarea></div>
    <div class="row">
        <div><label>Timezone</label><br /><input @bind="_timezone" /></div>
        <div><label>Currency</label><br /><input @bind="_currency" /></div>
        <div><label>Slot step (min)</label><br /><input @bind="_slotStep" type="number" /></div>
        <div><label>Buffer (min)</label><br /><input @bind="_buffer" type="number" /></div>
    </div>
    <div><label><input @bind="_bookingEnabled" type="checkbox" /> Booking enabled</label></div>

    <button @onclick="SaveAsync">Save</button>
}

@code {
    private bool _loading = true;
    private string _message = string.Empty;
    private string _error = string.Empty;

    private string _email = string.Empty;
    private string _displayName = string.Empty;
    private string _businessName = string.Empty;
    private string _aboutText = string.Empty;
    private string _greetingText = string.Empty;
    private string _timezone = "Europe/Madrid";
    private string _currency = "EUR";
    private int _slotStep = 15;
    private int _buffer;
    private bool _bookingEnabled = true;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated || Session.TenantId is null || Session.UserId is null)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        var profile = await ProfileRepository.GetAsync(Session.UserId.Value);
        var tenant = await TenantRepository.GetAsync(Session.TenantId.Value);
        _email = profile?.Email ?? Session.Email;
        _displayName = profile?.DisplayName ?? string.Empty;

        if (tenant is not null)
        {
            _businessName = tenant.BusinessName;
            _aboutText = tenant.AboutText ?? string.Empty;
            _greetingText = tenant.GreetingText;
            _timezone = tenant.Timezone;
            _currency = tenant.Currency;
            _slotStep = tenant.SlotStepMinutes;
            _buffer = tenant.DefaultBufferMinutes;
            _bookingEnabled = tenant.BookingEnabled;
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (Session.UserId is null || Session.TenantId is null) return;

        _message = string.Empty;
        _error = string.Empty;

        try
        {
            await ProfileRepository.UpsertAsync(new ProfileDto(Session.UserId.Value, _email, _displayName, DateTimeOffset.UtcNow));

            var existing = await TenantRepository.GetAsync(Session.TenantId.Value);
            if (existing is not null)
            {
                await TenantRepository.UpdateAsync(existing.Id, existing with
                {
                    BusinessName = _businessName,
                    AboutText = _aboutText,
                    GreetingText = _greetingText,
                    Timezone = _timezone,
                    Currency = _currency,
                    SlotStepMinutes = _slotStep,
                    DefaultBufferMinutes = _buffer,
                    BookingEnabled = _bookingEnabled
                });
            }

            _message = "Saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
