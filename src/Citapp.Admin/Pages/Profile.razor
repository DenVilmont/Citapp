@page "/profile"
@inject AdminSession Session
@inject ProfilePageService ProfilePageService
@inject NavigationManager Nav

<h3>Profile</h3>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    if (!string.IsNullOrWhiteSpace(_message))
    {
        <p>@_message</p>
    }
    if (!string.IsNullOrWhiteSpace(_error))
    {
        <p style="color:red">@_error</p>
    }

    <h4>Account</h4>
    <div><label>Email</label><br /><input @bind="_email" disabled /></div>
    <div><label>Display name</label><br /><input @bind="_displayName" /></div>

    <h4>Business</h4>
    <div><label>Business name</label><br /><input @bind="_businessName" /></div>
    <div><label>About</label><br /><textarea @bind="_aboutText"></textarea></div>
    <div><label>Greeting text</label><br /><textarea @bind="_greetingText"></textarea></div>
    <div class="row">
        <div><label>Timezone</label><br /><input @bind="_timezone" /></div>
        <div><label>Currency</label><br /><input @bind="_currency" /></div>
        <div><label>Slot step (min)</label><br /><input @bind="_slotStep" type="number" /></div>
        <div><label>Buffer (min)</label><br /><input @bind="_buffer" type="number" /></div>
    </div>
    <div><label><input @bind="_bookingEnabled" type="checkbox" /> Booking enabled</label></div>

    <button @onclick="SaveAsync">Save</button>
}

@code {
    private bool _loading = true;
    private string _message = string.Empty;
    private string _error = string.Empty;

    private string _email = string.Empty;
    private string _displayName = string.Empty;
    private string _businessName = string.Empty;
    private string _aboutText = string.Empty;
    private string _greetingText = string.Empty;
    private string _timezone = "Europe/Madrid";
    private string _currency = "EUR";
    private int _slotStep = 15;
    private int _buffer;
    private bool _bookingEnabled = true;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated || Session.TenantId is null || Session.UserId is null)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        var state = await ProfilePageService.LoadAsync(Session.UserId.Value, Session.TenantId.Value, Session.Email);
        _email = state.Email;
        _displayName = state.DisplayName;
        _businessName = state.BusinessName;
        _aboutText = state.AboutText;
        _greetingText = state.GreetingText;
        _timezone = state.Timezone;
        _currency = state.Currency;
        _slotStep = state.SlotStep;
        _buffer = state.Buffer;
        _bookingEnabled = state.BookingEnabled;

        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (Session.UserId is null || Session.TenantId is null) return;

        _message = string.Empty;
        _error = string.Empty;

        try
        {
            var error = await ProfilePageService.SaveAsync(
                Session.UserId.Value,
                Session.TenantId.Value,
                new ProfilePageState(
                    _email,
                    _displayName,
                    _businessName,
                    _aboutText,
                    _greetingText,
                    _timezone,
                    _currency,
                    _slotStep,
                    _buffer,
                    _bookingEnabled));

            if (error is not null)
            {
                _error = error;
                return;
            }

            _message = "Saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
