@page "/profile"
@inject AdminSession Session
@inject ProfilePageService ProfilePageService
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Class="mb-4">Profile</MudText>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@_message</MudAlert>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
    }

    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-3">Account</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_email" Label="Email" Disabled="true" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_displayName" Label="Display name" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-3">Business</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_businessName" Label="Business name" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_timezone" Label="Timezone" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_currency" Label="Currency" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField @bind-Value="_slotStep" Label="Slot step (min)" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField @bind-Value="_buffer" Label="Buffer (min)" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_aboutText" Label="About" Variant="Variant.Outlined" Lines="4" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_greetingText" Label="Greeting text" Variant="Variant.Outlined" Lines="4" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox @bind-Value="_bookingEnabled" Label="Booking enabled" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Save</MudButton>
}

@code {
    private bool _loading = true;
    private string _message = string.Empty;
    private string _error = string.Empty;

    private string _email = string.Empty;
    private string _displayName = string.Empty;
    private string _businessName = string.Empty;
    private string _aboutText = string.Empty;
    private string _greetingText = string.Empty;
    private string _timezone = "Europe/Madrid";
    private string _currency = "EUR";
    private int _slotStep = 15;
    private int _buffer;
    private bool _bookingEnabled = true;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated || Session.TenantId is null || Session.UserId is null)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        var state = await ProfilePageService.LoadAsync(Session.UserId.Value, Session.TenantId.Value, Session.Email);
        _email = state.Email;
        _displayName = state.DisplayName;
        _businessName = state.BusinessName;
        _aboutText = state.AboutText;
        _greetingText = state.GreetingText;
        _timezone = state.Timezone;
        _currency = state.Currency;
        _slotStep = state.SlotStep;
        _buffer = state.Buffer;
        _bookingEnabled = state.BookingEnabled;

        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (Session.UserId is null || Session.TenantId is null) return;

        _message = string.Empty;
        _error = string.Empty;

        try
        {
            var error = await ProfilePageService.SaveAsync(
                Session.UserId.Value,
                Session.TenantId.Value,
                new ProfilePageState(
                    _email,
                    _displayName,
                    _businessName,
                    _aboutText,
                    _greetingText,
                    _timezone,
                    _currency,
                    _slotStep,
                    _buffer,
                    _bookingEnabled));

            if (error is not null)
            {
                _error = error;
                return;
            }

            _message = "Saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
