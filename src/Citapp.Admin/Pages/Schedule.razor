@page "/schedule"
@inject AdminSession Session
@inject SchedulePageService SchedulePageService
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Class="mb-4">Schedule</MudText>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@_message</MudAlert>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
}

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Weekly hours</MudText>
    <MudTable Items="_week" Dense="true" Hover="true" Outlined="true">
        <HeaderContent>
            <MudTh>Day</MudTh>
            <MudTh>Working</MudTh>
            <MudTh>Start</MudTh>
            <MudTh>End</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Day">@DayName(context.DayOfWeek)</MudTd>
            <MudTd DataLabel="Working"><MudCheckBox @bind-Value="context.IsWorkingDay" Color="Color.Primary" /></MudTd>
            <MudTd DataLabel="Start"><MudTextField @bind-Value="context.StartText" Variant="Variant.Outlined" InputType="InputType.Time" Margin="Margin.Dense" /></MudTd>
            <MudTd DataLabel="End"><MudTextField @bind-Value="context.EndText" Variant="Variant.Outlined" InputType="InputType.Time" Margin="Margin.Dense" /></MudTd>
            <MudTd DataLabel="Save"><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SaveDayAsync(context)">Save</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Fixed breaks</MudText>
    <MudGrid>
        <MudItem xs="12" sm="3">
            <MudSelect T="int" Label="Day" @bind-Value="_breakDay" Variant="Variant.Outlined" Margin="Margin.Dense">
                @for (var i = 0; i < 7; i++)
                {
                    <MudSelectItem T="int" Value="@i">@DayName(i)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_breakStart" Label="Start" InputType="InputType.Time" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_breakEnd" Label="End" InputType="InputType.Time" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_breakLabel" Label="Label" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
    </MudGrid>
    <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddBreakAsync">Add break</MudButton>

    <MudList Dense="true" Class="mt-2">
        @foreach (var b in _breaks)
        {
            <MudListItem>
                <MudText>@DayName(b.DayOfWeek) @b.StartTime-@b.EndTime @b.Label</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteBreakAsync(b.Id)">Delete</MudButton>
            </MudListItem>
        }
    </MudList>
</MudPaper>

<MudPaper Class="pa-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">Blocked dates</MudText>
    <MudGrid>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_blockedDate" Label="Date" InputType="InputType.Date" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_blockedStart" Label="Start" InputType="InputType.Time" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_blockedEnd" Label="End" InputType="InputType.Time" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_blockedReason" Label="Reason" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
    </MudGrid>
    <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddBlockedDateAsync">Add blocked date</MudButton>

    <MudList Dense="true" Class="mt-2">
        @foreach (var b in _blocked)
        {
            <MudListItem>
                <MudText>@b.Date @b.StartTime-@b.EndTime @b.Reason</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteBlockedAsync(b.Id)">Delete</MudButton>
            </MudListItem>
        }
    </MudList>
</MudPaper>

@code {
    private readonly List<WorkingDayVm> _week = Enumerable.Range(0, 7).Select(i => new WorkingDayVm(i)).ToList();
    private List<FixedBreakDto> _breaks = new();
    private List<BlockedDateDto> _blocked = new();
    private string _error = string.Empty;
    private string _message = string.Empty;

    private int _breakDay;
    private string _breakStart = "12:00";
    private string _breakEnd = "13:00";
    private string _breakLabel = string.Empty;

    private string _blockedDate = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
    private string _blockedStart = string.Empty;
    private string _blockedEnd = string.Empty;
    private string _blockedReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated || Session.TenantId is null)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var from = DateOnly.FromDateTime(DateTime.UtcNow.Date);
        var data = await SchedulePageService.LoadAsync(Session.TenantId!.Value, from, from.AddDays(120));

        foreach (var day in _week)
        {
            var existing = data.Weekly.FirstOrDefault(x => x.DayOfWeek == day.DayOfWeek);
            if (existing is null) continue;
            day.IsWorkingDay = existing.IsWorkingDay;
            day.StartText = existing.StartTime.ToString("HH:mm");
            day.EndText = existing.EndTime.ToString("HH:mm");
        }

        _breaks = data.Breaks;
        _blocked = data.BlockedDates;
    }

    private async Task SaveDayAsync(WorkingDayVm day)
    {
        _error = string.Empty;
        _message = string.Empty;

        try
        {
            var error = await SchedulePageService.SaveDayAsync(
                Session.TenantId!.Value,
                new WorkingDayInput(day.DayOfWeek, day.IsWorkingDay, day.StartText, day.EndText));
            if (error is not null)
            {
                _error = error;
                return;
            }

            _message = "Day saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AddBreakAsync()
    {
        _error = string.Empty;
        _message = string.Empty;

        var isWorkingDay = _week.First(x => x.DayOfWeek == _breakDay).IsWorkingDay;
        var error = await SchedulePageService.AddBreakAsync(
            Session.TenantId!.Value,
            new BreakInput(_breakDay, _breakStart, _breakEnd, _breakLabel),
            isWorkingDay);

        if (error is not null)
        {
            _error = error;
            return;
        }

        _breakLabel = string.Empty;
        _message = "Break added.";
        await ReloadAsync();
    }

    private async Task DeleteBreakAsync(Guid id)
    {
        await SchedulePageService.DeleteBreakAsync(Session.TenantId!.Value, id);
        await ReloadAsync();
    }

    private async Task AddBlockedDateAsync()
    {
        _error = string.Empty;
        _message = string.Empty;

        var error = await SchedulePageService.AddBlockedDateAsync(
            Session.TenantId!.Value,
            new BlockedDateInput(_blockedDate, _blockedStart, _blockedEnd, _blockedReason));
        if (error is not null)
        {
            _error = error;
            return;
        }

        _blockedReason = string.Empty;
        _blockedStart = string.Empty;
        _blockedEnd = string.Empty;
        _message = "Blocked date added.";
        await ReloadAsync();
    }

    private async Task DeleteBlockedAsync(Guid id)
    {
        await SchedulePageService.DeleteBlockedDateAsync(Session.TenantId!.Value, id);
        await ReloadAsync();
    }

    private static string DayName(int day) => Enum.GetName(typeof(DayOfWeek), day) ?? day.ToString();

    private class WorkingDayVm
    {
        public WorkingDayVm(int dayOfWeek)
        {
            DayOfWeek = dayOfWeek;
            IsWorkingDay = dayOfWeek is not 0 and not 6;
        }

        public int DayOfWeek { get; }
        public bool IsWorkingDay { get; set; }
        public string StartText { get; set; } = "09:00";
        public string EndText { get; set; } = "18:00";
    }
}
