@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AdminSession Session

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @if (ShowNav)
    {
        <MudDrawer Elevation="1" Open="true" Variant="DrawerVariant.Mini" ClipMode="DrawerClipMode.Always" Width="250px" MiniWidth="72px">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">Citapp Admin</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                <MudNavLink Href="/profile" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>
                <MudNavLink Href="/servicelist" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ContentCut">Services</MudNavLink>
                <MudNavLink Href="/schedule" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Schedule">Schedule</MudNavLink>
                <MudNavLink Href="/bookingcalendar" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth">Bookings</MudNavLink>
                <MudNavLink Href="/customerlist" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups">Customers</MudNavLink>
            </MudNavMenu>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.Logout" OnClick="Logout" Class="ma-2">Logout</MudButton>
        </MudDrawer>
    }

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool ShowNav => !Nav.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase)
                            && !Nav.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase)
                            && !Nav.Uri.EndsWith("/register", StringComparison.OrdinalIgnoreCase);

    private async Task Logout()
    {
        await Session.LogoutAsync();
        Nav.NavigateTo("/login", true);
    }
}
